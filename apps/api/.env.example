# ─────────────────────────────────────────────────────────────
# API (apps/api) — copiar a apps/api/.env y ajustar.
# Nunca subas el archivo .env al repositorio.
# ─────────────────────────────────────────────────────────────

NODE_ENV=development
PORT=4000

# PostgreSQL local de docker-compose (puerto 5433 del host; ver .env.example en la raíz).
DATABASE_URL=postgresql://aei:aei_local_password@localhost:5433/aei_dev?schema=public

# Base de datos exclusiva para pruebas de integración (creada por infrastructure/database/init).
TEST_DATABASE_URL=postgresql://aei:aei_local_password@localhost:5433/aei_test?schema=public

# Orígenes permitidos por CORS, separados por comas (web en Next.js, Expo web).
CORS_ORIGINS=http://localhost:3000,http://localhost:8081

# Swagger UI en /api/docs (por defecto: activo fuera de producción).
# SWAGGER_ENABLED=true

# Solo si la API corre detrás de un proxy/balanceador de confianza.
TRUST_PROXY=false

# Rate limiting global: peticiones permitidas por IP en la ventana indicada.
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100

# ── Fases futuras (aún no se usan; no pongas valores reales aquí) ──
# REDIS_URL=redis://localhost:6379
# OPENAI_API_KEY=
# SENTRY_DSN=
