# ─────────────────────────────────────────────────────────────
# Web (apps/web) — copiar a apps/web/.env.local y ajustar.
#
# Variables SIN prefijo NEXT_PUBLIC_ solo existen en el servidor.
# Nunca pongas secretos en variables NEXT_PUBLIC_: se incrustan en el JS del navegador.
# ─────────────────────────────────────────────────────────────

# URL base de la API (sin /api/v1). Solo se usa desde el servidor de Next.js.
API_URL=http://localhost:4000
