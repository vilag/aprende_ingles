# ─────────────────────────────────────────────────────────────
# Variables de la RAÍZ: solo para docker-compose (infraestructura local).
# Copiar a .env (opcional: docker-compose tiene valores por defecto).
#
# Cada aplicación tiene su propio .env.example con sus variables:
#   apps/api/.env.example     → API (base de datos, CORS, rate limiting, …)
#   apps/web/.env.example     → Web (URL de la API, solo del lado del servidor)
#   apps/mobile/.env.example  → Móvil (URL pública de la API)
#
# Así ningún cliente (web/móvil) recibe secretos del backend.
# ─────────────────────────────────────────────────────────────

POSTGRES_USER=aei
POSTGRES_PASSWORD=aei_local_password
POSTGRES_DB=aei_dev
# 5433 para no chocar con un PostgreSQL instalado en Windows (5432).
POSTGRES_PORT=5433

REDIS_PORT=6379
