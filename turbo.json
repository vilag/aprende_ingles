{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "stream",
  // Modo estricto (Turbo 2): solo llegan a las tareas las variables declaradas aquí.
  // Ver docs/development/README.md → "Turborepo filtra variables".
  "globalEnv": ["NODE_ENV", "CI"],
  "globalPassThroughEnv": ["NEXT_TELEMETRY_DISABLED", "TURBO_TELEMETRY_DISABLED"],
  "tasks": {
    "db:generate": {
      "outputs": ["src/generated/**"]
    },
    "build": {
      "dependsOn": ["^build"],
      "env": ["NEXT_PUBLIC_*", "EXPO_PUBLIC_*"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test:integration": {
      "dependsOn": ["^build"],
      "env": ["TEST_DATABASE_URL"],
      "cache": false
    },
    "test:e2e": {
      "dependsOn": ["^build"],
      "env": ["E2E_API_URL"],
      "cache": false
    },
    "dev": {
      "dependsOn": ["^build"],
      "passThroughEnv": [
        "PORT",
        "DATABASE_URL",
        "CORS_ORIGINS",
        "API_URL",
        "NEXT_PUBLIC_*",
        "EXPO_PUBLIC_*"
      ],
      "cache": false,
      "persistent": true
    }
  }
}
